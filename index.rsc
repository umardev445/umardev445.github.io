1b:["$","section",null,{"className":"section section-green","children":["$","div",null,{"className":"shell","children":[["$","$L10",null,{"eyebrow":"QuranCrest resources","title":"A useful learning library, built to grow","description":"Read practical guides before joining, explore common learning questions, and return for new English and Urdu resources as the library develops."}],["$","div",null,{"className":"resource-preview","children":[["$","article",null,{"className":"resource-feature","children":[["$","p",null,{"className":"eyebrow light","children":"Featured guide"}],["$","h3",null,{"children":"How Online Quran Classes Work: A Beginner's Guide"}],["$","p",null,{"children":"Understand how one-to-one online Quran lessons are scheduled, taught and supported before booking your first class."}],["$","$Lb",null,{"className":"text-link","href":"/blog/how-online-quran-classes-work/","children":["Read the guide ",["$","$Lc",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]]}],["$","div",null,{"className":"resource-stack","children":[["$","article","adult-beginner",{"className":"resource-card","children":[["$","p",null,{"className":"eyebrow","children":"Beginners"}],["$","h3",null,{"children":"Can an adult begin Quran reading from the alphabet?"}],["$","p",null,{"children":"Yes. Adult learners can begin with Arabic letter recognition and progress at a private, respectful pace. A short assessment helps identify the most useful starting lesson."}],["$","$Lb",null,{"className":"text-link","href":"/resources/masail/","children":["More questions ",["$","$Lc",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]]}],["$","article","child-class-length",{"className":"resource-card","children":[["$","p",null,{"className":"eyebrow","children":"Parents"}],["$","h3",null,{"children":"How long should an online Quran class be for a child?"}],["$","p",null,{"children":"The right length depends on age, attention and learning level. Many families begin with short focused sessions and adjust after observing the child's concentration and progress."}],["$","$Lb",null,{"className":"text-link","href":"/resources/masail/","children":["More questions ",["$","$Lc",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]]}]]}]]}]]}]}]
1c:["$","section",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell faq-layout","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Before you enroll"}],["$","h2",null,{"children":"Questions families often ask"}],["$","p",null,{"children":"Still unsure about the right course? The free assessment is designed to answer that without obligation."}],["$","$Lb",null,{"className":"text-link","href":"/contact/","children":["Ask another question ",["$","$Lc",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]]}],["$","$L21",null,{"items":[{"question":"How do online Quran classes work?","answer":"Lessons take place live by video call. A tutor works one-to-one with the learner on Qaida, Quran reading, Tajweed, memorization or Islamic studies according to an agreed plan."},{"question":"Are male and female Quran teachers available?","answer":"Yes. Families can request a male or female tutor. Matching depends on the course, preferred time and current tutor availability."},{"question":"Can you schedule classes for different countries?","answer":"QuranCrest serves learners worldwide. Share your country, time zone and preferred lesson window during the free assessment so suitable options can be discussed."},{"question":"Is the first assessment free?","answer":"Yes. The initial learning assessment is free and no card is required. It helps identify the learner's level, goals and suitable course."}]}]]}]}]
