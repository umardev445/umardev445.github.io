1:["$","main",null,{"id":"main-content","children":[["$","section",null,{"className":"home-hero","aria-labelledby":"home-title","children":[["$","img",null,{"className":"hero-image","src":"/images/qurancrest-hero-learning.webp","alt":"A father supporting his son during an online Quran lesson at home","width":"1584","height":"990","fetchPriority":"high"}],["$","div",null,{"className":"shell hero-content","children":["$","div",null,{"className":"hero-copy","children":[["$","p",null,{"className":"eyebrow light","children":"Private online Quran learning"}],["$","h1",null,{"id":"home-title","children":["Learn the Quran with ",["$","span",null,{"children":"clarity, care and purpose."}]]}],["$","p",null,{"children":"One-to-one online Quran classes for children and adults, guided by patient male and female tutors and scheduled around your local time."}],["$","div",null,{"className":"hero-actions","children":[["$","$Lb",null,{"className":"button button-ivory","href":"/free-assessment/","children":["Book a free assessment ",["$","$Lc",null,{"ref":"$undefined","iconNode":"$8:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}],["$","$Le",null,{"className":"button button-ghost-light","children":[["$","$Lc",null,{"ref":"$undefined","iconNode":[["path",{"d":"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719","key":"1sd12s"}]],"className":"lucide-message-circle"}]," Ask on WhatsApp"]}]]}],["$","div",null,{"className":"hero-note","children":[["$","span",null,{"children":[["$","$Lc",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check"}]," No card required"]}],["$","span",null,{"children":[["$","$Lc",null,{"ref":"$undefined","iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"M12 6v6h4","key":"135r8i"}]],"className":"lucide-clock3 lucide-clock-3"}]," Flexible worldwide timings"]}],["$","span",null,{"children":[["$","$Lc",null,{"ref":"$undefined","iconNode":[["path",{"d":"M2 21a8 8 0 0 1 13.292-6","key":"bjp14o"}],["circle",{"cx":"10","cy":"8","r":"5","key":"o932ke"}],["path",{"d":"m16 19 2 2 4-4","key":"1b14m6"}]],"className":"lucide-user-round-check"}]," Male & female tutor options"]}]]}]]}]}]]}],["$","$Lf",null,{}],["$","section",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell","children":[["$","$L10",null,{"eyebrow":"Choose a learning path","title":"A clear course for every starting point","description":"Begin from the Arabic alphabet, improve Quran reading, study practical Tajweed or follow a consistent memorization plan. Each course is adapted to the learner, not delivered as a generic group lesson."}],["$","div",null,{"className":"course-grid","children":[["$","$L11","noorani-qaida",{"course":{"slug":"noorani-qaida","name":"Noorani Qaida for Beginners","eyebrow":"Build the foundation","summary":"Live one-to-one Noorani Qaida classes for children and adults learning Arabic letters, sounds, joining and the foundations of Quran reading.","audience":"Children, adults and complete beginners","outcomes":["Recognize Arabic letters in different forms","Join letters and read short words","Build accurate pronunciation habits","Prepare for guided Quran reading"],"keywords":["online Noorani Qaida classes","Noorani Qaida for beginners","Noorani Qaida for kids","Noorani Qaida for adults","learn Noorani Qaida online"],"seoTitle":"Online Noorani Qaida Classes | Kids & Adults","seoDescription":"Learn Noorani Qaida online in private one-to-one classes for kids and adults. Build Arabic letter recognition, pronunciation and joining step by step.","lastModified":"2026-09-04","detail":{"overviewHeading":"Learn Noorani Qaida online from the first letter","overview":["Noorani Qaida is a structured starting point for learners who cannot yet read Arabic confidently. It introduces Arabic letters and their sounds before moving gradually into joined forms, vowel marks and simple Quranic words. Instead of asking a beginner to guess or memorize a page, the tutor demonstrates each sound, listens to the learner and corrects mistakes as they appear.","QuranCrest teaches this foundation through live one-to-one lessons. The starting lesson is selected after a free assessment, so a complete beginner can begin with individual letters while a returning learner can restart from the first skill that needs correction. The aim is not to rush through the book; it is to develop reading habits that prepare the learner for guided Quran reading."],"curriculum":[{"title":"1. Arabic letters and clear sounds","description":"Recognize individual Arabic letters and practise their basic sounds with direct tutor demonstration and correction."},{"title":"2. Letter shapes and joining","description":"Identify how letters change at the beginning, middle and end of words, then read simple joined combinations."},{"title":"3. Short vowels and Tanween","description":"Read letters and short combinations with Fathah, Kasrah, Dammah and double-vowel patterns without relying on guesswork."},{"title":"4. Sukoon and Shaddah","description":"Practise resting letters and doubled sounds carefully, with repetition focused on the learner's recurring mistakes."},{"title":"5. Madd and Leen foundations","description":"Develop an introductory understanding of long and soft sounds so words are read with greater control and consistency."},{"title":"6. Connected words and Quran-reading preparation","description":"Combine the earlier skills in longer words and selected reading exercises before moving into guided reading from the Quran."}],"whoFor":["Children beginning Arabic reading for the first time","Adults who want to learn Quran reading from the alphabet","Learners returning after a long break or an incomplete foundation","Non-Arabic speakers who need patient, step-by-step guidance","Learners who recognize some letters but struggle to join or pronounce them"],"lessonSteps":[{"title":"Review","description":"The learner reads the previous exercise so the tutor can check recognition, pronunciation and retention."},{"title":"Demonstration","description":"The tutor introduces a small new skill and demonstrates the relevant letter, sign or reading pattern."},{"title":"Guided reading","description":"The learner reads aloud while the tutor gives immediate, focused correction and asks for careful repetition."},{"title":"Practice target","description":"The lesson ends with a manageable section to revise before the next class, based on age and current ability."}],"ageGuidance":[{"title":"Noorani Qaida for kids","description":"Children usually benefit from short explanations, frequent repetition and one clear practice target. Parents can support younger learners by preparing the device, keeping the learning space calm and checking the assigned lines between lessons."},{"title":"Noorani Qaida for adults","description":"Adult beginners can start from individual letters without embarrassment. Lessons can spend more time on difficult sounds, familiar mistakes and a practice routine that fits work and family responsibilities."}],"practice":["Review the exact letters or lines assigned by the tutor instead of moving ahead alone.","Practise briefly and regularly, focusing first on accuracy rather than speed.","Read aloud so sounds can be heard clearly; silent recognition alone does not build recitation skill.","Keep a simple note of letters or combinations that require extra correction."],"readiness":["recognizes letters consistently in different positions","reads common vowel and joining patterns with less prompting","applies the pronunciation points already taught with reasonable consistency","can approach connected Quranic words without guessing each letter"],"faqs":[{"question":"What is Noorani Qaida?","answer":"Noorani Qaida is a beginner learning sequence that introduces Arabic letters, their sounds, joined forms, vowel marks and basic reading patterns. It helps prepare a learner for guided Quran reading."},{"question":"Does a learner need previous Arabic knowledge?","answer":"No. A complete beginner can start from individual Arabic letters. The free assessment helps identify whether the learner should begin at the first lesson or at a later foundation skill."},{"question":"Are these Noorani Qaida classes suitable for both kids and adults?","answer":"Yes. Children and adults can both learn Noorani Qaida, but the explanation style, amount of repetition and home-practice target are adjusted to the learner's age and ability."},{"question":"How do online Noorani Qaida classes work?","answer":"Lessons are live and one-to-one. The tutor demonstrates a sound or reading pattern, listens as the student reads, corrects mistakes in real time and sets a manageable practice target."},{"question":"How long does it take to complete Noorani Qaida?","answer":"There is no single completion time for every learner. Progress depends on starting level, age, attendance, lesson frequency and regular practice. The tutor recommends the next stage when the foundation is ready rather than relying on a fixed deadline."},{"question":"Can I request a male or female Quran tutor?","answer":"Yes. You can share a male or female tutor preference during enrollment. Matching depends on the learner's level, preferred language, time zone and current tutor availability."},{"question":"What does the learner need for an online class?","answer":"A learner needs a reliable phone, tablet or computer, stable internet, a quiet place to read and the Qaida material recommended for the lesson. Headphones may help when sounds need close listening."},{"question":"What comes after Noorani Qaida?","answer":"Once the learner can apply the foundation with reasonable consistency, the tutor may recommend guided Quran Reading. Tajweed study can continue progressively as reading becomes more stable."}],"relatedCourses":["quran-reading","quran-classes-for-kids","quran-classes-for-adults","tajweed"]}}}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}]]}]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]
