1f:["$","$L23",null,{"data":{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do online Quran classes work?","acceptedAnswer":{"@type":"Answer","text":"Lessons take place live by video call. A tutor works one-to-one with the learner on Qaida, Quran reading, Tajweed, memorization or Islamic studies according to an agreed plan."}},{"@type":"Question","name":"Are male and female Quran teachers available?","acceptedAnswer":{"@type":"Answer","text":"Yes. Families can request a male or female tutor. Matching depends on the course, preferred time and current tutor availability."}},{"@type":"Question","name":"Can you schedule classes for different countries?","acceptedAnswer":{"@type":"Answer","text":"QuranCrest serves learners worldwide. Share your country, time zone and preferred lesson window during the free assessment so suitable options can be discussed."}},{"@type":"Question","name":"Is the first assessment free?","acceptedAnswer":{"@type":"Answer","text":"Yes. The initial learning assessment is free and no card is required. It helps identify the learner's level, goals and suitable course."}}]}}]
