0:{"__route":"route:/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/":"$L1","layout:/":[[[["$","link","css:/assets/index-DUdv4bwh.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DUdv4bwh.css","data-rsc-css-href":"/assets/index-DUdv4bwh.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","$L2",null,{}],["$","$L3",null,{}],["$","$L4",null,{}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"EducationalOrganization\",\"@id\":\"https://qurancrest.com/#academy\",\"name\":\"QuranCrest Academy\",\"url\":\"https://qurancrest.com\",\"logo\":\"https://qurancrest.com/logo.svg\",\"description\":\"A bilingual online Quran academy offering private classes for children and adults worldwide.\",\"email\":\"umarfarooq360official@gmail.com\",\"telephone\":\"+923421046878\",\"areaServed\":\"Worldwide\",\"availableLanguage\":[\"English\",\"Urdu\"],\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"Admissions\",\"telephone\":\"+923421046878\",\"email\":\"umarfarooq360official@gmail.com\",\"availableLanguage\":[\"English\",\"Urdu\"]}}"}}]]}]}]],null],"route:/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Online Quran Classes for Kids & Adults | QuranCrest"}],["$","meta","1",{"name":"description","content":"One-to-one online Quran classes for kids and adults with male and female tutors, flexible worldwide timings and a free learning assessment."}],["$","meta","2",{"name":"application-name","content":"QuranCrest Academy"}],["$","meta","3",{"name":"author","content":"QuranCrest Academy"}],["$","link","4",{"rel":"author","href":"https://qurancrest.com"}],["$","meta","5",{"name":"creator","content":"QuranCrest Academy"}],["$","meta","6",{"name":"publisher","content":"QuranCrest Academy"}],["$","meta","7",{"name":"category","content":"education"}],["$","meta","8",{"property":"og:title","content":"Online Quran Classes for Kids & Adults | QuranCrest"}],["$","meta","9",{"property":"og:description","content":"Private online Quran learning with patient tutors, flexible scheduling and a clear personal study plan."}],["$","meta","10",{"property":"og:url","content":"https://qurancrest.com"}],["$","meta","11",{"property":"og:site_name","content":"QuranCrest Academy"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"property":"og:locale","content":"en_US"}],["$","meta","14",{"name":"twitter:card","content":"summary"}],["$","meta","15",{"name":"twitter:title","content":"QuranCrest Academy"}],["$","meta","16",{"name":"twitter:description","content":"One-to-one online Quran classes for learners worldwide."}],["$","link","17",{"rel":"shortcut icon","href":"https://qurancrest.com/favicon.svg"}],["$","link","18",{"rel":"icon","href":"https://qurancrest.com/favicon.svg"}],["$","link","19",{"rel":"manifest","href":"https://qurancrest.com/manifest.webmanifest"}],["$","link","20",{"rel":"canonical","href":"https://qurancrest.com/"}],["$","link","21",{"rel":"alternate","hrefLang":"en","href":"https://qurancrest.com/"}],["$","link","22",{"rel":"alternate","hrefLang":"ur-PK","href":"https://qurancrest.com/ur/"}],["$","link","23",{"rel":"alternate","hrefLang":"x-default","href":"https://qurancrest.com/"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"name":"theme-color","content":"#0b4d3b"}]]],["$","$L5",null,{"segmentMap":{"children":[]},"children":["$","$L6",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L7",null,{"resetKey":"","fallback":["$","main",null,{"id":"main-content","children":["$","section",null,{"className":"page-hero","children":["$","div",null,{"className":"shell page-hero-inner","children":[["$","p",null,{"class