1:["$","main",null,{"id":"main-content","children":[["$","$Ld",null,{"eyebrow":"Academy information","title":"Child Safety & Parent Standards","description":"Practical expectations for a transparent, parent-aware online learning environment.","compact":true}],["$","$Le",null,{"items":[{"name":"Home","href":"/"},{"name":"Child Safety & Parent Standards"}]}],["$","article",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell policy","children":[[["$","h2",null,{"children":"Parent presence and awareness"}],["$","p",null,{"children":"A parent or responsible guardian should manage enrollment for a child, know the class schedule and remain reasonably available during lessons. Younger children should learn in a shared or observable area of the home."}],["$","h2",null,{"children":"Respectful communication"}],["$","p",null,{"children":"Tutors and staff should use communication channels approved for enrollment and learning. Children should not be asked to share private contact details, payment information or sensitive documents during class."}],["$","h2",null,{"children":"Learning environment"}],["$","p",null,{"children":"Students and tutors are expected to dress and communicate respectfully. Families should report any uncomfortable interaction promptly through the academy's listed email or WhatsApp contact."}],["$","h2",null,{"children":"Images and recordings"}],["$","p",null,{"children":"Classes should not be recorded, photographed or used for promotion without clear permission from the responsible adult and all relevant parties."}]],["$","div",null,{"className":"notice","style":{"marginTop":45},"children":[["$","strong",null,{"children":"Keep this page current"}],["$","p",null,{"children":"Review this policy whenever payment, lesson delivery, data collection or child-safety processes change."}]]}]]}]}]]}]
