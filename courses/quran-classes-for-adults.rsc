1a:["$","ul",null,{"children":[["$","li","Adults who have never learned to read Arabic",{"children":"Adults who have never learned to read Arabic"}],["$","li","Returning learners who studied Quran as children and need a fresh start",{"children":"Returning learners who studied Quran as children and need a fresh start"}],["$","li","New Muslims seeking patient, assumption-free Quran reading support",{"children":"New Muslims seeking patient, assumption-free Quran reading support"}],["$","li","Busy professionals, students and parents who need a manageable routine",{"children":"Busy professionals, students and parents who need a manageable routine"}],["$","li","Adults who can read but want more accurate pronunciation or Tajweed",{"children":"Adults who can read but want more accurate pronunciation or Tajweed"}],["$","li","Learners who prefer English or Urdu explanations and private correction",{"children":"Learners who prefer English or Urdu explanations and private correction"}]]}]
1b:["$","h2",null,{"children":"How a live one-to-one lesson works"}]
1c:["$","div",null,{"className":"library-grid","children":[["$","section","Review the current priority",{"className":"library-card","children":[["$","h3",null,{"children":"Review the current priority"}],["$","p",null,{"children":"Begin with the previous reading or practice target so the tutor can see what has become secure and what still causes hesitation."}]]}],["$","section","Explain the next useful skill",{"className":"library-card","children":[["$","h3",null,{"children":"Explain the next useful skill"}],["$","p",null,{"children":"The tutor introduces a letter pattern, word, verse or recitation rule connected to the adult learner's actual pathway."}]]}],["$","section","Read aloud and receive correction",{"className":"library-card","children":[["$","h3",null,{"children":"Read aloud and receive correction"}],["$","p",null,{"children":"The learner practises privately, repeats the difficult section and asks questions while the sound or reading pattern is still clear."}]]}],["$","section","Agree on realistic practice",{"className":"library-card","children":[["$","h3",null,{"children":"Agree on realistic practice"}],["$","p",null,{"children":"The lesson ends with a specific target that can fit around work, family, study and the selected class frequency."}]]}]]}]
1d:["$","h2",null,{"children":"Support shaped around the learner"}]
1e:["$","section","Complete adult beginners",{"children":[["$","h3",null,{"children":"Complete adult beginners"}],["$","p",null,{"children":"No previous Arabic knowledge is required. Beginning with individual letters is a normal starting point, and one-to-one teaching means the learner does not need to keep pace with children or a group."}]]}]
1f:["$","section","Returning and developing readers",{"children":[["$","h3",null,{"children":"Returning and developing readers"}],["$","p",null,{"children":"An adult who already recognizes letters does not automatically need to restart the whole Qaida. The tutor can identify the first weak pattern and connect it to Quran reading or Tajweed practice."}]]}]
20:["$","h2",null,{"children":"How to practise between lessons"}]
21:["$","ul",null,{"children":[["$","li","Choose a short regular practice time that can survive a busy week.",{"children":"Choose a short regular practice time that can survive a busy week."}],["$","li","Read aloud, because visual recognition alone does not reveal pronunciation or hesitation.",{"children":"Read aloud, because visual recognition alone does not reveal pronunciation or hesitation."}],["$","li","Repeat the exact corrected word or line before adding a larger new portion.",{"children":"Repeat the exact corrected word or line before adding a larger new portion."}],["$","li","Keep a simple note of personal mistakes and the tutor's current priority.",{"children":"Keep a simple note of personal mistakes and the tutor's current priority."}],["$","li","Tell the tutor when the plan is unrealistic so the target can be reduced instead of quietly abandoned.",{"children":"Tell the tutor when the plan is unrealistic so the target can be reduced instead of quietly abandoned."}]]}]
22:["$","h2",null,{"children":"How progress and readiness are reviewed"}]
23:["$","p",null,{"children":"Finishing pages alone does not confirm progress. The tutor can recommend the next stage when the learner:"}]
24:["$","ul",null,{"children":[["$","li","recognizes and joins the patterns already studied with less prompting",{"children":"recognizes and joins the patterns already studied with less prompting"}],["$","li","reads the assigned passage with fewer repeated mistakes",{"children":"reads the assigned passage with fewer repeated mistakes"}],["$","li","applies a correction again in a new word or verse",{"children":"applies a correction again in a new word or verse"}],["$","li","maintains a realistic review routine between live lessons",{"children":"maintains a realistic review routine between live lessons"}],["$","li","can explain the current goal and the next skill being developed",{"children":"can explain the current goal and the next skill being developed"}]]}]
25:["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Continue through a connected learning path"}],["$","p",null,{"children":"The free assessment helps confirm whether the learner should continue this course or move to a related Quran learning program."}],["$","ul",null,{"children":[["$","li","noorani-qaida",{"children":["$","$Lc",null,{"className":"text-link","href":"/courses/noorani-qaida/","children":"Noorani Qaida for Beginners"}]}],["$","li","quran-reading",{"children":["$","$Lc",null,{"className":"text-link","href":"/courses/quran-reading/","children":"Online Quran Reading Classes"}]}],["$","li","tajweed",{"children":["$","$Lc",null,{"className":"text-link","href":"/courses/tajweed/","children":"Online Tajweed Classes"}]}],["$","li","quran-memorization",{"children":["$","$Lc",null,{"className":"text-link","href":"/courses/quran-memorization/","children":"Online Quran Memorization (Hifz)"}]}],["$","li","female-quran-teacher",{"children":["$","$Lc",null,{"className":"text-link","href":"/courses/female-quran-teacher/","children":"Online Quran Classes with Female Teachers"}]}]]}]]}]
26:["$","$L2c",null,{"eyebrow":"Course questions","title":"What learners and families usually ask"}]
27:["$","$L2d",null,{"items":[{"question":"Can I learn to read the Quran as a complete adult beginner?","answer":"Yes. An adult with no Arabic background can begin with individual letters, basic sounds, vowel marks and joining through Noorani Qaida before moving into Quran reading."},{"question":"Am I too old to start online Quran classes?","answer":"There is no age limit for beginning. The useful question is which skill should come first and what practice routine is realistic for your present responsibilities."},{"question":"I learned Quran as a child but forgot it. Must I restart everything?","answer":"Not necessarily. The assessment checks what you still recognize and where reading begins to break down. You can review the first weak foundation instead of repeating secure material without a reason."},{"question":"Are adult Quran lessons private?","answer":"Yes. QuranCrest lessons are live and one-to-one, so the tutor can listen closely and you can ask questions or repeat without group pressure."},{"question":"Which course is best for an adult beginner?","answer":"A complete beginner often starts with Noorani Qaida. An adult who already reads may begin with Quran Reading or Tajweed, while memorization requires a suitable reading and revision foundation."},{"question":"Can new Muslims join QuranCrest adult classes?","answer":"Yes. Share your background and immediate learning goal during the assessment. The tutor should not assume previous Arabic or Quran-reading knowledge."},{"question":"Can I request a female Quran teacher for an adult learner?","answer":"Yes. Male or female tutor preferences can be shared during enrollment. Matching depends on your level, language, time zone and current tutor availability."},{"question":"How long will it take me to learn Quran reading?","answer":"There is no reliable fixed timeline before assessment. Starting level, lesson frequency, pronunciation needs and regular practice all affect progress."},{"question":"What equipment do I need for online Quran classes?","answer":"You need a phone, tablet or computer with stable internet, clear audio, a quiet place to read aloud and the Qaida or Mushaf material recommended for your lesson."}]}]
