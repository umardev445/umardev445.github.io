18:["$","div",null,{"className":"library-grid","children":[["$","section","1. Private adult starting assessment",{"className":"library-card","children":[["$","h3",null,{"children":"1. Private adult starting assessment"}],["$","p",null,{"children":"Discuss the goal and read at a comfortable level so the tutor can check letters, joining, pronunciation, fluency, previous study and available practice time."}]]}],["$","section","2. Arabic letters and Qaida where needed",{"className":"library-card","children":[["$","h3",null,{"children":"2. Arabic letters and Qaida where needed"}],["$","p",null,{"children":"A complete beginner can learn letter shapes, sounds, vowels and joining without embarrassment, while a returning learner reviews only the weak foundation patterns."}]]}],["$","section","3. Guided Quran reading from the Mushaf",{"className":"library-card","children":[["$","h3",null,{"children":"3. Guided Quran reading from the Mushaf"}],["$","p",null,{"children":"Apply foundation skills to connected Quranic words and passages, with correction for hesitation, skipped sounds, tracking and common reading mistakes."}]]}],["$","section","4. Pronunciation and practical Tajweed",{"className":"library-card","children":[["$","h3",null,{"children":"4. Pronunciation and practical Tajweed"}],["$","p",null,{"children":"Work on relevant makharij and recitation rules in the learner's passage, focusing on recurring habits rather than overwhelming lists of terminology."}]]}],["$","section","5. Personal recitation or memorization goals",{"className":"library-card","children":[["$","h3",null,{"children":"5. Personal recitation or memorization goals"}],["$","p",null,{"children":"Once the reading foundation is suitable, the plan can include fluency, selected Surah memorization, revision or a more focused Tajweed pathway."}]]}],["$","section","6. Sustainable review and next-step planning",{"className":"library-card","children":[["$","h3",null,{"children":"6. Sustainable review and next-step planning"}],["$","p",null,{"children":"Use short practice targets and periodic review to decide whether to consolidate the current level or move into a connected course."}]]}]]}]
