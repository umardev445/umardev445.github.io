nk","href":"/courses/quran-memorization/","children":"Online Quran Memorization (Hifz)"}]}],["$","li","female-quran-teacher",{"children":["$","$Lc",null,{"className":"text-link","href":"/courses/female-quran-teacher/","children":"Online Quran Classes with Female Teachers"}]}]]}]]}],["$","p",null,{"style":{"marginTop":24},"children":["$","$Lc",null,{"className":"text-link","href":"/blog/how-online-quran-classes-work/","children":["See how online Quran classes work before you begin"," ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$a:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]}]]}]
