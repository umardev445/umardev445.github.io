12:["$","p",null,{"children":"The exact starting point and pace depend on the initial assessment. These stages show the skills a learner can work through without promising an identical timeline for every student."}]
13:["$","div",null,{"className":"library-grid","children":[["$","section","1. Arabic letters and clear sounds",{"className":"library-card","children":[["$","h3",null,{"children":"1. Arabic letters and clear sounds"}],["$","p",null,{"children":"Recognize individual Arabic letters and practise their basic sounds with direct tutor demonstration and correction."}]]}],["$","section","2. Letter shapes and joining",{"className":"library-card","children":[["$","h3",null,{"children":"2. Letter shapes and joining"}],["$","p",null,{"children":"Identify how letters change at the beginning, middle and end of words, then read simple joined combinations."}]]}],["$","section","3. Short vowels and Tanween",{"className":"library-card","children":[["$","h3",null,{"children":"3. Short vowels and Tanween"}],["$","p",null,{"children":"Read letters and short combinations with Fathah, Kasrah, Dammah and double-vowel patterns without relying on guesswork."}]]}],["$","section","4. Sukoon and Shaddah",{"className":"library-card","children":[["$","h3",null,{"children":"4. Sukoon and Shaddah"}],["$","p",null,{"children":"Practise resting letters and doubled sounds carefully, with repetition focused on the learner's recurring mistakes."}]]}],["$","section","5. Madd and Leen foundations",{"className":"library-card","children":[["$","h3",null,{"children":"5. Madd and Leen foundations"}],["$","p",null,{"children":"Develop an introductory understanding of long and soft sounds so words are read with greater control and consistency."}]]}],["$","section","6. Connected words and Quran-reading preparation",{"className":"library-card","children":[["$","h3",null,{"children":"6. Connected words and Quran-reading preparation"}],["$","p",null,{"children":"Combine the earlier skills in longer words and selected reading exercises before moving into guided reading from the Quran."}]]}]]}]
