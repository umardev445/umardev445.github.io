15:["$","ul",null,{"children":[["$","li","Children beginning Arabic reading for the first time",{"children":"Children beginning Arabic reading for the first time"}],["$","li","Adults who want to learn Quran reading from the alphabet",{"children":"Adults who want to learn Quran reading from the alphabet"}],["$","li","Learners returning after a long break or an incomplete foundation",{"children":"Learners returning after a long break or an incomplete foundation"}],["$","li","Non-Arabic speakers who need patient, step-by-step guidance",{"children":"Non-Arabic speakers who need patient, step-by-step guidance"}],["$","li","Learners who recognize some letters but struggle to join or pronounce them",{"children":"Learners who recognize some letters but struggle to join or pronounce them"}]]}]
