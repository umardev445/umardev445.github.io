19:["$","section","Noorani Qaida for kids",{"children":[["$","h3",null,{"children":"Noorani Qaida for kids"}],["$","p",null,{"children":"Children usually benefit from short explanations, frequent repetition and one clear practice target. Parents can support younger learners by preparing the device, keeping the learning space calm and checking the assigned lines between lessons."}]]}]
1a:["$","section","Noorani Qaida for adults",{"children":[["$","h3",null,{"children":"Noorani Qaida for adults"}],["$","p",null,{"children":"Adult beginners can start from individual letters without embarrassment. Lessons can spend more time on difficult sounds, familiar mistakes and a practice routine that fits work and family responsibilities."}]]}]
1b:["$","h2",null,{"children":"How to practise between lessons"}]
1c:["$","ul",null,{"children":[["$","li","Review the exact letters or lines assigned by the tutor instead of moving ahead alone.",{"children":"Review the exact letters or lines assigned by the tutor instead of moving ahead alone."}],["$","li","Practise briefly and regularly, focusing first on accuracy rather than speed.",{"children":"Practise briefly and regularly, focusing first on accuracy rather than speed."}],["$","li","Read aloud so sounds can be heard clearly; silent recognition alone does not build recitation skill.",{"children":"Read aloud so sounds can be heard clearly; silent recognition alone does not build recitation skill."}],["$","li","Keep a simple note of letters or combinations that require extra correction.",{"children":"Keep a simple note of letters or combinations that require extra correction."}]]}]
1d:["$","h2",null,{"children":"How progress and readiness are reviewed"}]
1e:["$","p",null,{"children":"Finishing pages alone does not confirm progress. The tutor can recommend the next stage when the learner:"}]
1f:["$","ul",null,{"children":[["$","li","recognizes letters consistently in different positions",{"children":"recognizes letters consistently in different positions"}],["$","li","reads common vowel and joining patterns with less prompting",{"children":"reads common vowel and joining patterns with less prompting"}],["$","li","applies the pronunciation points already taught with reasonable consistency",{"children":"applies the pronunciation points already taught with reasonable consistency"}],["$","li","can approach connected Quranic words without guessing each letter",{"children":"can approach connected Quranic words without guessing each letter"}]]}]
20:["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Continue through a connected learning path"}],["$","p",null,{"children":"The free assessment helps confirm whether the learner should continue this course or move to a related Quran learning program."}],["$","ul",null,{"children":[["$","li","quran-reading",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-reading/","children":"Online Quran Reading Classes"}]}],["$","li","quran-classes-for-kids",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-classes-for-kids/","children":"Online Quran Classes for Kids"}]}],["$","li","quran-classes-for-adults",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-classes-for-adults/","children":"Online Quran Classes for Adults"}]}],["$","li","tajweed",{"children":["$","$La",null,{"className":"text-link","href":"/courses/tajweed/","children":"Online Tajweed Classes"}]}]]}]]}]
21:["$","$L27",null,{"eyebrow":"Course questions","title":"What learners and families usually ask"}]
22:["$","$L28",null,{"items":[{"question":"What is Noorani Qaida?","answer":"Noorani Qaida is a beginner learning sequence that introduces Arabic letters, their sounds, joined forms, vowel marks and basic reading patterns. It helps prepare a learner for guided Quran reading."},{"question":"Does a learner need previous Arabic knowledge?","answer":"No. A complete beginner can start from individual Arabic letters. The free assessment helps identify whether the learner should begin at the first lesson or at a later foundation skill."},{"question":"Are these Noorani Qaida classes suitable for both kids and adults?","answer":"Yes. Children and adults can both learn Noorani Qaida, but the explanation style, amount of repetition and home-practice target are adjusted to the learner's age and ability."},{"question":"How do online Noorani Qaida classes work?","answer":"Lessons are live and one-to-one. The tutor demonstrates a sound or reading pattern, listens as the student reads, corrects mistakes in real time and sets a manageable practice target."},{"question":"How long does it take to complete Noorani Qaida?","answer":"There is no single completion time for every learner. Progress depends on starting level, age, attendance, lesson frequency and regular practice. The tutor recommends the next stage when the foundation is ready rather than relying on a fixed deadline."},{"question":"Can I request a male or female Quran tutor?","answer":"Yes. You can share a male or female tutor preference during enrollment. Matching depends on the learner's level, preferred language, time zone and current tutor availability."},{"question":"What does the learner need for an online class?","answer":"A learner needs a reliable phone, tablet or computer, stable internet, a quiet place to read and the Qaida material recommended for the lesson. Headphones may help when sounds need close listening."},{"question":"What comes after Noorani Qaida?","answer":"Once the learner can apply the foundation with reasonable consistency, the tutor may recommend guided Quran Reading. Tajweed study can continue progressively as reading becomes more stable."}]}]
