17:["$","div",null,{"className":"library-grid","children":[["$","section","Review",{"className":"library-card","children":[["$","h3",null,{"children":"Review"}],["$","p",null,{"children":"The learner reads the previous exercise so the tutor can check recognition, pronunciation and retention."}]]}],["$","section","Demonstration",{"className":"library-card","children":[["$","h3",null,{"children":"Demonstration"}],["$","p",null,{"children":"The tutor introduces a small new skill and demonstrates the relevant letter, sign or reading pattern."}]]}],["$","section","Guided reading",{"className":"library-card","children":[["$","h3",null,{"children":"Guided reading"}],["$","p",null,{"children":"The learner reads aloud while the tutor gives immediate, focused correction and asks for careful repetition."}]]}],["$","section","Practice target",{"className":"library-card","children":[["$","h3",null,{"children":"Practice target"}],["$","p",null,{"children":"The lesson ends with a manageable section to revise before the next class, based on age and current ability."}]]}]]}]
