25:["$","$L2a",null,{"data":{"@context":"https://schema.org","@type":"Course","@id":"https://qurancrest.com/courses/noorani-qaida/#course","name":"Noorani Qaida for Beginners","description":"Learn Noorani Qaida online in private one-to-one classes for kids and adults. Build Arabic letter recognition, pronunciation and joining step by step.","url":"https://qurancrest.com/courses/noorani-qaida/","provider":{"@type":"EducationalOrganization","@id":"https://qurancrest.com/#academy","name":"QuranCrest Academy"},"educationalLevel":"Children, adults and complete beginners","inLanguage":["en","ur"],"coursePrerequisites":"$undefined","teaches":["Recognize Arabic letters in different forms","Join letters and read short words","Build accurate pronunciation habits","Prepare for guided Quran reading"]}}]
26:["$","$L2a",null,{"data":{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is Noorani Qaida?","acceptedAnswer":{"@type":"Answer","text":"Noorani Qaida is a beginner learning sequence that introduces Arabic letters, their sounds, joined forms, vowel marks and basic reading patterns. It helps prepare a learner for guided Quran reading."}},{"@type":"Question","name":"Does a learner need previous Arabic knowledge?","acceptedAnswer":{"@type":"Answer","text":"No. A complete beginner can start from individual Arabic letters. The free assessment helps identify whether the learner should begin at the first lesson or at a later foundation skill."}},{"@type":"Question","name":"Are these Noorani Qaida classes suitable for both kids and adults?","acceptedAnswer":{"@type":"Answer","text":"Yes. Children and adults can both learn Noorani Qaida, but the explanation style, amount of repetition and home-practice target are adjusted to the learner's age and ability."}},{"@type":"Question","name":"How do online Noorani Qaida classes work?","acceptedAnswer":{"@type":"Answer","text":"Lessons are live and one-to-one. The tutor demonstrates a sound or reading pattern, listens as the student reads, corrects mistakes in real time and sets a manageable practice target."}},{"@type":"Question","name":"How long does it take to complete Noorani Qaida?","acceptedAnswer":{"@type":"Answer","text":"There is no single completion time for every learner. Progress depends on starting level, age, attendance, lesson frequency and regular practice. The tutor recommends the next stage when the foundation is ready rather than relying on a fixed deadline."}},{"@type":"Question","name":"Can I request a male or female Quran tutor?","acceptedAnswer":{"@type":"Answer","text":"Yes. You can share a male or female tutor preference during enrollment. Matching depends on the learner's level, preferred language, time zone and current tutor availability."}},{"@type":"Question","name":"What does the learner need for an online class?","acceptedAnswer":{"@type":"Answer","text":"A learner needs a reliable phone, tablet or computer, stable internet, a quiet place to read and the Qaida material recommended for the lesson. Headphones may help when sounds need close listening."}},{"@type":"Question","name":"What comes after Noorani Qaida?","acceptedAnswer":{"@type":"Answer","text":"Once the learner can apply the foundation with reasonable consistency, the tutor may recommend guided Quran Reading. Tajweed study can continue progressively as reading becomes more stable."}}]}}]
