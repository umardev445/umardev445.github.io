19:["$","ul",null,{"children":[["$","li","Children ready to memorize short Surahs or begin a structured Hifz pathway",{"children":"Children ready to memorize short Surahs or begin a structured Hifz pathway"}],["$","li","Adults who want to memorize selected passages with a realistic routine",{"children":"Adults who want to memorize selected passages with a realistic routine"}],["$","li","Learners beginning Juz Amma memorization online",{"children":"Learners beginning Juz Amma memorization online"}],["$","li","Students who have memorized before but need to rebuild weak revision",{"children":"Students who have memorized before but need to rebuild weak revision"}],["$","li","Learners who need a tutor to listen, correct and maintain accountability",{"children":"Learners who need a tutor to listen, correct and maintain accountability"}],["$","li","Families seeking a one-to-one plan around school, work and local time zones",{"children":"Families seeking a one-to-one plan around school, work and local time zones"}]]}]
