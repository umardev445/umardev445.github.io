1b:["$","div",null,{"className":"library-grid","children":[["$","section","Recite older revision",{"className":"library-card","children":[["$","h3",null,{"children":"Recite older revision"}],["$","p",null,{"children":"The tutor listens to an assigned older portion and notes weak verses, transitions or recitation mistakes that need another review cycle."}]]}],["$","section","Check recent memorization",{"className":"library-card","children":[["$","h3",null,{"children":"Check recent memorization"}],["$","p",null,{"children":"Recently learned passages are recited from memory to see whether they remain stable after the first days of learning."}]]}],["$","section","Present the new lesson",{"className":"library-card","children":[["$","h3",null,{"children":"Present the new lesson"}],["$","p",null,{"children":"The learner recites the prepared new portion, repeats corrected sections and confirms where the next lesson should begin."}]]}],["$","section","Set a balanced target",{"className":"library-card","children":[["$","h3",null,{"children":"Set a balanced target"}],["$","p",null,{"children":"The next assignment states the new portion, recent review and older revision separately so one part does not replace the others."}]]}]]}]
1c:["$","h2",null,{"children":"Support shaped around the learner"}]
1d:["$","section","Quran memorization for kids",{"children":[["$","h3",null,{"children":"Quran memorization for kids"}],["$","p",null,{"children":"Children benefit from a target they can repeat consistently, a stable lesson time and parent awareness of the revision assignment. School workload and attention should be considered before increasing the new portion."}]]}]
1e:["$","section","Quran memorization for adults",{"children":[["$","h3",null,{"children":"Quran memorization for adults"}],["$","p",null,{"children":"Adults may begin with selected Surahs or a smaller daily target around work and family. A sustainable plan with honest revision is more useful than a large target that cannot be maintained."}]]}]
1f:["$","h2",null,{"children":"How to practise between lessons"}]
20:["$","ul",null,{"children":[["$","li","Read the new passage accurately before beginning repeated memorization.",{"children":"Read the new passage accurately before beginning repeated memorization."}],["$","li","Separate new lesson, recent review and older revision in the daily plan.",{"children":"Separate new lesson, recent review and older revision in the daily plan."}],["$","li","Repeat difficult verse transitions deliberately instead of restarting the whole passage every time.",{"children":"Repeat difficult verse transitions deliberately instead of restarting the whole passage every time."}],["$","li","Recite without looking only after the section has been prepared, then check the Mushaf for errors.",{"children":"Recite without looking only after the section has been prepared, then check the Mushaf for errors."}],["$","li","Tell the tutor when school, work or health reduces practice time so the target can be adjusted.",{"children":"Tell the tutor when school, work or health reduces practice time so the target can be adjusted."}]]}]
