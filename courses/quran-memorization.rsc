22:["$","p",null,{"children":"Finishing pages alone does not confirm progress. The tutor can recommend the next stage when the learner:"}]
23:["$","ul",null,{"children":[["$","li","recites the assigned new portion with manageable prompting",{"children":"recites the assigned new portion with manageable prompting"}],["$","li","retains recent lessons while continuing the current plan",{"children":"retains recent lessons while continuing the current plan"}],["$","li","reviews older memorization without repeatedly abandoning difficult sections",{"children":"reviews older memorization without repeatedly abandoning difficult sections"}],["$","li","corrects identified word or pronunciation errors before they become habitual",{"children":"corrects identified word or pronunciation errors before they become habitual"}],["$","li","maintains the agreed revision routine often enough to support the next target",{"children":"maintains the agreed revision routine often enough to support the next target"}]]}]
24:["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Continue through a connected learning path"}],["$","p",null,{"children":"The free assessment helps confirm whether the learner should continue this course or move to a related Quran learning program."}],["$","ul",null,{"children":[["$","li","quran-reading",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/quran-reading/","children":"Online Quran Reading Classes"}]}],["$","li","tajweed",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/tajweed/","children":"Online Tajweed Classes"}]}],["$","li","quran-classes-for-kids",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/quran-classes-for-kids/","children":"Online Quran Classes for Kids"}]}],["$","li","quran-classes-for-adults",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/quran-classes-for-adults/","children":"Online Quran Classes for Adults"}]}],["$","li","female-quran-teacher",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/female-quran-teacher/","children":"Online Quran Classes with Female Teachers"}]}]]}]]}]
25:["$","$L2b",null,{"eyebrow":"Course questions","title":"What learners and families usually ask"}]
26:["$","$L2c",null,{"items":[{"question":"How do online Quran memorization classes work?","answer":"The learner prepares an assigned portion, recites it from memory to a live tutor and also reviews recent and older memorization. The tutor corrects mistakes and adjusts the next target according to recall and available practice time."},{"question":"What are Sabaq, Sabqi and Manzil in Hifz?","answer":"These terms commonly separate the new lesson, recently memorized review and older revision. The exact portions and naming may vary, but the purpose is to prevent new memorization from replacing necessary review."},{"question":"Can my child memorize Juz Amma online?","answer":"Yes, Juz Amma or selected short Surahs can be a suitable goal for some children. The assessment checks reading, recall, attention and family routine before recommending the first portion."},{"question":"Can adults join online Hifz classes?","answer":"Yes. Adults can work toward selected Surahs, Juz Amma, revision of previous memorization or a longer goal. The plan should match work, family and realistic independent practice time."},{"question":"Does a learner need Tajweed before starting Hifz?","answer":"The passage should be read accurately enough before it is memorized. A learner with significant reading or pronunciation gaps may be advised to strengthen Quran Reading or Tajweed first, or to combine correction with a limited memorization target."},{"question":"How much should a student memorize each day?","answer":"There is no suitable fixed amount for everyone. The target depends on age, reading fluency, retention, lesson frequency and how much revision the learner can maintain."},{"question":"How long does it take to memorize the Quran online?","answer":"A responsible timeline cannot be promised before assessing the learner. Full completion, selected Surahs and revision-only goals are very different, and progress depends heavily on consistency and retention."},{"question":"Can I request a male or female Hifz tutor?","answer":"Yes. Share the preference during enrollment. Matching depends on the learner's goal, level, language, time zone and current tutor availability."}]}]
