17:["$","div",null,{"className":"library-grid","children":[["$","section","1. Hifz readiness and goal assessment",{"className":"library-card","children":[["$","h3",null,{"children":"1. Hifz readiness and goal assessment"}],["$","p",null,{"children":"Review reading accuracy, present memorization, recall, schedule and the intended goal before choosing the first portion and revision load."}]]}],["$","section","2. Recitation accuracy before memorizing",{"className":"library-card","children":[["$","h3",null,{"children":"2. Recitation accuracy before memorizing"}],["$","p",null,{"children":"Read the new passage with the tutor and correct important pronunciation or word-reading mistakes before committing it to memory."}]]}],["$","section","3. Sabaq: a manageable new lesson",{"className":"library-card","children":[["$","h3",null,{"children":"3. Sabaq: a manageable new lesson"}],["$","p",null,{"children":"Prepare and recite a suitable new portion. Its length depends on age, fluency, retention and the time available for careful preparation."}]]}],["$","section","4. Sabqi: recent lesson review",{"className":"library-card","children":[["$","h3",null,{"children":"4. Sabqi: recent lesson review"}],["$","p",null,{"children":"Revisit recently memorized passages so they are not displaced by the newest lesson and weak transitions can be corrected early."}]]}],["$","section","5. Manzil or older revision",{"className":"library-card","children":[["$","h3",null,{"children":"5. Manzil or older revision"}],["$","p",null,{"children":"Maintain a rotating review of older memorized material, with additional attention given to passages where recall has weakened."}]]}],["$","section","6. Recall checks and plan adjustment",{"className":"library-card","children":[["$","h3",null,{"children":"6. Recall checks and plan adjustment"}],["$","p",null,{"children":"Use recitation checks to decide whether to continue, reduce the new portion or pause new memorization while revision is strengthened."}]]}]]}]
