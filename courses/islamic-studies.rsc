19:["$","ul",null,{"children":[["$","li","Children beginning structured Islamic learning at home",{"children":"Children beginning structured Islamic learning at home"}],["$","li","Muslim families living where regular local classes are difficult to access",{"children":"Muslim families living where regular local classes are difficult to access"}],["$","li","Children who know some duas or stories but need an organized foundation",{"children":"Children who know some duas or stories but need an organized foundation"}],["$","li","English-speaking children who benefit from clear explanations",{"children":"English-speaking children who benefit from clear explanations"}],["$","li","Urdu-speaking families who want language support where available",{"children":"Urdu-speaking families who want language support where available"}],["$","li","Parents seeking one-to-one lessons connected to the child's age and questions",{"children":"Parents seeking one-to-one lessons connected to the child's age and questions"}]]}]
1a:["$","h2",null,{"children":"How a live one-to-one lesson works"}]
1b:["$","div",null,{"className":"library-grid","children":[["$","section","Recall the previous idea",{"className":"library-card","children":[["$","h3",null,{"children":"Recall the previous idea"}],["$","p",null,{"children":"The child answers a short question, explains a previous concept or reviews a dua so the tutor can see what was understood and remembered."}]]}],["$","section","Introduce one connected topic",{"className":"library-card","children":[["$","h3",null,{"children":"Introduce one connected topic"}],["$","p",null,{"children":"The tutor teaches a manageable belief, worship point, story or manner using words and examples appropriate to the child's age."}]]}],["$","section","Discuss and check understanding",{"className":"library-card","children":[["$","h3",null,{"children":"Discuss and check understanding"}],["$","p",null,{"children":"The child asks questions, gives an example or retells the lesson in simple language instead of only repeating the tutor's wording."}]]}],["$","section","Choose a home review target",{"className":"library-card","children":[["$","h3",null,{"children":"Choose a home review target"}],["$","p",null,{"children":"The class ends with a small task such as revising a dua, explaining an idea to a parent or noticing how the lesson applies during the week."}]]}]]}]
1c:["$","h2",null,{"children":"Support shaped around the learner"}]
1d:["$","section","Younger children",{"children":[["$","h3",null,{"children":"Younger children"}],["$","p",null,{"children":"Young learners generally need shorter explanations, repetition, simple stories and one practical takeaway. A parent can remain aware of the topic and help with the assigned review."}]]}]
1e:["$","section","Older children and early teens",{"children":[["$","h3",null,{"children":"Older children and early teens"}],["$","p",null,{"children":"Older learners can explore reasons, compare everyday situations, keep brief notes and ask more detailed questions. The tutor should still distinguish foundational teaching from issues that require family or scholar consultation."}]]}]
1f:["$","h2",null,{"children":"How to practise between lessons"}]
20:["$","ul",null,{"children":[["$","li","Ask the child to explain the lesson in their own words instead of memorizing a paragraph only.",{"children":"Ask the child to explain the lesson in their own words instead of memorizing a paragraph only."}],["$","li","Connect one manner or worship topic with a real home or school situation during the week.",{"children":"Connect one manner or worship topic with a real home or school situation during the week."}],["$","li","Review selected duas regularly with meaning appropriate to the child's level.",{"children":"Review selected duas regularly with meaning appropriate to the child's level."}],["$","li","Keep a respectful list of questions that need more explanation in the next lesson.",{"children":"Keep a respectful list of questions that need more explanation in the next lesson."}],["$","li","Parents should review the current topic and raise any curriculum or scholarly concerns with the academy early.",{"children":"Parents should review the current topic and raise any curriculum or scholarly concerns with the academy early."}]]}]
21:["$","h2",null,{"children":"How progress and readiness are reviewed"}]
22:["$","p",null,{"children":"Finishing pages alone does not confirm progress. The tutor can recommend the next stage when the learner:"}]
23:["$","ul",null,{"children":[["$","li","recalls the central idea without only repeating a memorized sentence",{"children":"recalls the central idea without only repeating a memorized sentence"}],["$","li","gives an age-appropriate example of how the lesson affects daily conduct",{"children":"gives an age-appropriate example of how the lesson affects daily conduct"}],["$","li","reviews selected duas or worship steps with fewer prompts",{"children":"reviews selected duas or worship steps with fewer prompts"}],["$","li","asks relevant questions and can distinguish the current topic from a different issue",{"children":"asks relevant questions and can distinguish the current topic from a different issue"}],["$","li","connects new learning with earlier beliefs, stories or manners already studied",{"children":"connects new learning with earlier beliefs, stories or manners already studied"}]]}]
24:["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Continue through a connected learning path"}],["$","p",null,{"children":"The free assessment helps confirm whether the learner should continue this course or move to a related Quran learning program."}],["$","ul",null,{"children":[["$","li","quran-classes-for-kids",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/quran-classes-for-kids/","children":"Online Quran Classes for Kids"}]}],["$","li","noorani-qaida",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/noorani-qaida/","children":"Noorani Qaida for Beginners"}]}],["$","li","quran-reading",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/quran-reading/","children":"Online Quran Reading Classes"}]}],["$","li","female-quran-teacher",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/female-quran-teacher/","children":"Online Quran Classes with Female Teachers"}]}]]}]]}]
25:["$","$L2b",null,{"eyebrow":"Course questions","title":"What learners and families usually ask"}]
26:["$","$L2c",null,{"items":[{"question":"What do online Islamic Studies classes for kids cover?","answer":"The pathway can include essential beliefs, pillars of Islam and Iman, cleanliness, Salah, fasting, daily duas, Seerah, selected Prophets' stories and Islamic manners. Topics are selected according to age and prior knowledge."},{"question":"What age can a child start Islamic Studies online?","answer":"There is no single starting age for every child. Readiness depends on attention, communication, previous learning and family support. The initial conversation helps select an age-appropriate first topic."},{"question":"Does my child need to read Arabic first?","answer":"No Arabic-reading prerequisite is required for general Islamic Studies. Quran reading can be studied through a connected Noorani Qaida or Quran Reading course when needed."},{"question":"Are lessons taught in English or Urdu?","answer":"QuranCrest supports English and Urdu communication. The available language and tutor match should be confirmed during enrollment."},{"question":"Are Islamic Studies lessons one-to-one?","answer":"Yes. Live one-to-one lessons allow the tutor to adapt the explanation, ask the child questions and spend more time on misunderstood concepts."},{"question":"How can parents support the course at home?","answer":"Parents can ask what the child learned, review the selected dua or practical target, and tell the tutor when a topic needs clearer explanation or should align with a family concern."},{"question":"Can my child ask religious questions during class?","answer":"Yes. The tutor can answer age-appropriate foundational questions within their knowledge. Personal or complex rulings may need to be referred to a suitably qualified scholar rather than answered casually."},{"question":"Can I request a female Islamic Studies teacher?","answer":"Yes. Share a male or female tutor preference during enrollment. Matching depends on the child's level, language, time zone and current tutor availability."}]}]
