16:["$","p",null,{"children":"The exact starting point and pace depend on the initial assessment. These stages show the skills a learner can work through without promising an identical timeline for every student."}]
17:["$","div",null,{"className":"library-grid","children":[["$","section","1. Starting knowledge and family goals",{"className":"library-card","children":[["$","h3",null,{"children":"1. Starting knowledge and family goals"}],["$","p",null,{"children":"Identify what the child already understands, which daily practices need support and which topics the family wants the course to prioritize."}]]}],["$","section","2. Essential beliefs and pillars",{"className":"library-card","children":[["$","h3",null,{"children":"2. Essential beliefs and pillars"}],["$","p",null,{"children":"Introduce core beliefs, the pillars of Islam and Iman, and the meaning of worship using language and examples suitable for the child's age."}]]}],["$","section","3. Cleanliness, Salah and daily worship",{"className":"library-card","children":[["$","h3",null,{"children":"3. Cleanliness, Salah and daily worship"}],["$","p",null,{"children":"Learn age-appropriate foundations related to cleanliness, Wudu, Salah, fasting and respectful worship, with practical review instead of facts alone."}]]}],["$","section","4. Duas and everyday Muslim manners",{"className":"library-card","children":[["$","h3",null,{"children":"4. Duas and everyday Muslim manners"}],["$","p",null,{"children":"Study selected daily duas together with honesty, kindness, respect for parents, responsibility and conduct in common home or school situations."}]]}],["$","section","5. Seerah and selected Prophets' stories",{"className":"library-card","children":[["$","h3",null,{"children":"5. Seerah and selected Prophets' stories"}],["$","p",null,{"children":"Explore carefully selected events and lessons through clear storytelling, then ask what the child can understand and apply from them."}]]}],["$","section","6. Review, questions and family connection",{"className":"library-card","children":[["$","h3",null,{"children":"6. Review, questions and family connection"}],["$","p",null,{"children":"Use short recall questions, explanations in the child's own words and a simple home review target to reinforce the current topic."}]]}]]}]
