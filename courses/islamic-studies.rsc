acher",{"children":["$","$Lb",null,{"className":"text-link","href":"/courses/female-quran-teacher/","children":"Online Quran Classes with Female Teachers"}]}]]}]]}],["$","p",null,{"style":{"marginTop":24},"children":["$","$Lb",null,{"className":"text-link","href":"/tutors/","children":["Meet the QuranCrest teaching team"," ",["$","$Lc",null,{"ref":"$undefined","iconNode":"$9:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]}]]}]
