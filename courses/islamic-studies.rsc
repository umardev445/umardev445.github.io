29:["$","$L2e",null,{"data":{"@context":"https://schema.org","@type":"Course","@id":"https://qurancrest.com/courses/islamic-studies/#course","name":"Online Islamic Studies for Kids","description":"Online Islamic Studies for kids with live age-appropriate lessons in beliefs, worship, duas, Seerah and manners. English and Urdu support available.","url":"https://qurancrest.com/courses/islamic-studies/","provider":{"@type":"EducationalOrganization","@id":"https://qurancrest.com/#academy","name":"QuranCrest Academy"},"educationalLevel":"Children who need a structured, age-aware foundation in everyday Islamic learning","inLanguage":["en","ur"],"coursePrerequisites":"No Arabic-reading prerequisite is required for general Islamic Studies. Content and explanation are selected according to the child's age, prior knowledge and family goals.","teaches":["Understand essential Islamic concepts in age-appropriate language","Connect worship, duas and manners with daily situations","Retell selected Seerah lessons and their practical meaning","Review clear learning targets with family at home"]}}]
2a:["$","$L2e",null,{"data":{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What do online Islamic Studies classes for kids cover?","acceptedAnswer":{"@type":"Answer","text":"The pathway can include essential beliefs, pillars of Islam and Iman, cleanliness, Salah, fasting, daily duas, Seerah, selected Prophets' stories and Islamic manners. Topics are selected according to age and prior knowledge."}},{"@type":"Question","name":"What age can a child start Islamic Studies online?","acceptedAnswer":{"@type":"Answer","text":"There is no single starting age for every child. Readiness depends on attention, communication, previous learning and family support. The initial conversation helps select an age-appropriate first topic."}},{"@type":"Question","name":"Does my child need to read Arabic first?","acceptedAnswer":{"@type":"Answer","text":"No Arabic-reading prerequisite is required for general Islamic Studies. Quran reading can be studied through a connected Noorani Qaida or Quran Reading course when needed."}},{"@type":"Question","name":"Are lessons taught in English or Urdu?","acceptedAnswer":{"@type":"Answer","text":"QuranCrest supports English and Urdu communication. The available language and tutor match should be confirmed during enrollment."}},{"@type":"Question","name":"Are Islamic Studies lessons one-to-one?","acceptedAnswer":{"@type":"Answer","text":"Yes. Live one-to-one lessons allow the tutor to adapt the explanation, ask the child questions and spend more time on misunderstood concepts."}},{"@type":"Question","name":"How can parents support the course at home?","acceptedAnswer":{"@type":"Answer","text":"Parents can ask what the child learned, review the selected dua or practical target, and tell the tutor when a topic needs clearer explanation or should align with a family concern."}},{"@type":"Question","name":"Can my child ask religious questions during class?","acceptedAnswer":{"@type":"Answer","text":"Yes. The tutor can answer age-appropriate foundational questions within their knowledge. Personal or complex rulings may need to be referred to a suitably qualified scholar rather than answered casually."}},{"@type":"Question","name":"Can I request a female Islamic Studies teacher?","acceptedAnswer":{"@type":"Answer","text":"Yes. Share a male or female tutor preference during enrollment. Matching depends on the child's level, language, time zone and current tutor availability."}}]}}]
