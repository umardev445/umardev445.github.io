18:["$","ul",null,{"children":[["$","li","Quran readers who want practical Tajweed correction rather than rules alone",{"children":"Quran readers who want practical Tajweed correction rather than rules alone"}],["$","li","Adults returning to recitation after a long break",{"children":"Adults returning to recitation after a long break"}],["$","li","Children who can read connected Quranic text and are ready for focused correction",{"children":"Children who can read connected Quranic text and are ready for focused correction"}],["$","li","Learners who confuse particular Arabic letters or repeat the same sound patterns",{"children":"Learners who confuse particular Arabic letters or repeat the same sound patterns"}],["$","li","Readers preparing for a memorization plan who first need steadier recitation",{"children":"Readers preparing for a memorization plan who first need steadier recitation"}],["$","li","English- or Urdu-speaking learners who prefer private live instruction",{"children":"English- or Urdu-speaking learners who prefer private live instruction"}]]}]
