1a:["$","div",null,{"className":"library-grid","children":[["$","section","Listen to the current reading",{"className":"library-card","children":[["$","h3",null,{"children":"Listen to the current reading"}],["$","p",null,{"children":"The learner recites a review passage while the tutor identifies which earlier correction is secure and which one still needs attention."}]]}],["$","section","Explain one practical priority",{"className":"library-card","children":[["$","h3",null,{"children":"Explain one practical priority"}],["$","p",null,{"children":"A relevant articulation point or rule is demonstrated with a small number of clear examples connected to the learner's passage."}]]}],["$","section","Apply, correct and repeat",{"className":"library-card","children":[["$","h3",null,{"children":"Apply, correct and repeat"}],["$","p",null,{"children":"The learner reads the target words and verses aloud, receives immediate feedback and repeats the corrected section without rushing."}]]}],["$","section","Record the practice focus",{"className":"library-card","children":[["$","h3",null,{"children":"Record the practice focus"}],["$","p",null,{"children":"The lesson ends with a specific passage and one or two correction priorities to revisit before the next live class."}]]}]]}]
1b:["$","h2",null,{"children":"Support shaped around the learner"}]
1c:["$","section","Tajweed classes for developing readers",{"children":[["$","h3",null,{"children":"Tajweed classes for developing readers"}],["$","p",null,{"children":"A learner who is still guessing letters or struggling to join words may progress better by strengthening the reading foundation first. The assessment helps decide whether to begin with Qaida, Quran Reading or focused Tajweed."}]]}]
1d:["$","section","Tajweed for kids and adults",{"children":[["$","h3",null,{"children":"Tajweed for kids and adults"}],["$","p",null,{"children":"Children may use shorter examples and more repetition, while adults may prefer clearer rule explanations and notes about long-standing habits. Both still need to recite aloud for the tutor to hear the actual application."}]]}]
1e:["$","h2",null,{"children":"How to practise between lessons"}]
1f:["$","ul",null,{"children":[["$","li","Review the exact words and verses corrected in class before moving to a new passage.",{"children":"Review the exact words and verses corrected in class before moving to a new passage."}],["$","li","Practise one articulation or rule priority at a time instead of trying to monitor every rule together.",{"children":"Practise one articulation or rule priority at a time instead of trying to monitor every rule together."}],["$","li","Read aloud at a controlled pace so difficult sounds and timings can be heard clearly.",{"children":"Read aloud at a controlled pace so difficult sounds and timings can be heard clearly."}],["$","li","Keep a short personal correction list and remove an item only when it is applied consistently.",{"children":"Keep a short personal correction list and remove an item only when it is applied consistently."}],["$","li","Use a reliable recitation selected with the tutor for listening practice, but do not replace live correction with imitation alone.",{"children":"Use a reliable recitation selected with the tutor for listening practice, but do not replace live correction with imitation alone."}]]}]
20:["$","h2",null,{"children":"How progress and readiness are reviewed"}]
21:["$","p",null,{"children":"Finishing pages alone does not confirm progress. The tutor can recommend the next stage when the learner:"}]
22:["$","ul",null,{"children":[["$","li","distinguishes previously confused letters more consistently",{"children":"distinguishes previously confused letters more consistently"}],["$","li","applies the studied rule in a new example with less prompting",{"children":"applies the studied rule in a new example with less prompting"}],["$","li","maintains accuracy when moving from isolated words to a longer passage",{"children":"maintains accuracy when moving from isolated words to a longer passage"}],["$","li","stops and restarts with greater care at the level already taught",{"children":"stops and restarts with greater care at the level already taught"}],["$","li","recognizes a recurring mistake and can attempt the correction independently",{"children":"recognizes a recurring mistake and can attempt the correction independently"}]]}]
23:["$","div",null,{"className":"notice","children":[["$","strong",null,{"children":"Continue through a connected learning path"}],["$","p",null,{"children":"The free assessment helps confirm whether the learner should continue this course or move to a related Quran learning program."}],["$","ul",null,{"children":[["$","li","quran-reading",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-reading/","children":"Online Quran Reading Classes"}]}],["$","li","noorani-qaida",{"children":["$","$La",null,{"className":"text-link","href":"/courses/noorani-qaida/","children":"Noorani Qaida for Beginners"}]}],["$","li","quran-classes-for-adults",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-classes-for-adults/","children":"Online Quran Classes for Adults"}]}],["$","li","quran-classes-for-kids",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-classes-for-kids/","children":"Online Quran Classes for Kids"}]}],["$","li","quran-memorization",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-memorization/","children":"Online Quran Memorization (Hifz)"}]}]]}]]}]
24:["$","$L2a",null,{"eyebrow":"Course questions","title":"What learners and families usually ask"}]
25:["$","$L2b",null,{"items":[{"question":"What do online Tajweed classes teach?","answer":"Lessons can cover letter articulation, sound qualities, selected Noon and Meem rules, Madd, Qalqalah, stopping and other rules relevant to the learner's level. The main focus is applying what is taught during real Quran recitation."},{"question":"Can a complete beginner start with Tajweed?","answer":"Basic pronunciation can be introduced from the beginning, but a learner who does not yet recognize or join Arabic letters may need Noorani Qaida first. The assessment identifies the most useful starting point."},{"question":"Are Tajweed classes suitable for adults and children?","answer":"Yes. Both can learn through one-to-one lessons, but the length of examples, explanation style, repetition and practice target are adjusted to age and reading ability."},{"question":"Will I study Tajweed rules or only recite?","answer":"Lessons combine concise rule explanation with guided recitation. A rule is most useful when the learner can hear it, identify it in the passage and apply it while reading aloud."},{"question":"How are makharij corrected online?","answer":"The tutor demonstrates the target sound, listens to the learner, compares confused letters and asks for focused repetition in syllables, words and verses. Clear audio and a quiet space make this easier."},{"question":"How long does an online Tajweed course take?","answer":"There is no identical timeline for every reader. Starting accuracy, lesson frequency, practice and the depth of study all affect progress. The tutor reviews applied recitation rather than promising a fixed completion date."},{"question":"Can I request a male or female Tajweed tutor?","answer":"Yes. Share your preference during enrollment. Matching depends on the learner's level, language, time zone and current tutor availability."},{"question":"What do I need for a live Tajweed lesson?","answer":"Use a phone, tablet or computer with stable internet and clear audio, keep the assigned Mushaf or text ready, and join from a quiet place where you can recite aloud."}]}]
