14:["$","h2",null,{"children":["Online Tajweed Classes"," curriculum and learning path"]}]
15:["$","p",null,{"children":"The exact starting point and pace depend on the initial assessment. These stages show the skills a learner can work through without promising an identical timeline for every student."}]
16:["$","div",null,{"className":"library-grid","children":[["$","section","1. Recitation and makharij assessment",{"className":"library-card","children":[["$","h3",null,{"children":"1. Recitation and makharij assessment"}],["$","p",null,{"children":"Read a suitable passage aloud so the tutor can identify articulation, vowel, joining, nasalization, elongation and stopping patterns that need attention."}]]}],["$","section","2. Letter articulation and sound quality",{"className":"library-card","children":[["$","h3",null,{"children":"2. Letter articulation and sound quality"}],["$","p",null,{"children":"Practise difficult Arabic letters from their points of articulation and compare commonly confused sounds before applying them inside words and verses."}]]}],["$","section","3. Noon, Tanween and Meem patterns",{"className":"library-card","children":[["$","h3",null,{"children":"3. Noon, Tanween and Meem patterns"}],["$","p",null,{"children":"Study the relevant rules progressively and hear how they change connected recitation, with examples selected from the learner's reading rather than memorized as definitions only."}]]}],["$","section","4. Madd, Qalqalah and controlled timing",{"className":"library-card","children":[["$","h3",null,{"children":"4. Madd, Qalqalah and controlled timing"}],["$","p",null,{"children":"Work on elongation and echoing sounds at the level appropriate to the learner, using measured repetition to reduce both overextension and rushed reading."}]]}],["$","section","5. Applying rules in continuous recitation",{"className":"library-card","children":[["$","h3",null,{"children":"5. Applying rules in continuous recitation"}],["$","p",null,{"children":"Read longer passages while maintaining the rules already studied, with focused correction for the mistakes that return when attention is divided."}]]}],["$","section","6. Waqf, restarting and personal review",{"className":"library-card","children":[["$","h3",null,{"children":"6. Waqf, restarting and personal review"}],["$","p",null,{"children":"Develop more careful stopping and restarting habits, then maintain a correction list that connects each lesson with the next practice target."}]]}]]}]
