1d:["$","section","Online Quran classes for ladies",{"children":[["$","h3",null,{"children":"Online Quran classes for ladies"}],["$","p",null,{"children":"Adult sisters can start from zero, rebuild an earlier foundation or focus on Tajweed and memorization. The pace can be adjusted around work, family and a realistic home-practice routine."}]]}]
1e:["$","section","Female Quran tutors for girls and younger learners",{"children":[["$","h3",null,{"children":"Female Quran tutors for girls and younger learners"}],["$","p",null,{"children":"Girls and younger children may benefit from shorter explanations, frequent repetition and parent awareness of the lesson target. QuranCrest recommends an observable learning area for younger students."}]]}]
