17:["$","div",null,{"className":"library-grid","children":[["$","section","1. Learner assessment and tutor preference",{"className":"library-card","children":[["$","h3",null,{"children":"1. Learner assessment and tutor preference"}],["$","p",null,{"children":"Share the learner's age, current reading, goal, language, time zone and female-tutor preference so the course and available match can be considered together."}]]}],["$","section","2. Noorani Qaida for complete beginners",{"className":"library-card","children":[["$","h3",null,{"children":"2. Noorani Qaida for complete beginners"}],["$","p",null,{"children":"Begin with Arabic letters, sounds, vowel marks and joining when the learner does not yet have a reliable reading foundation."}]]}],["$","section","3. Guided Quran reading",{"className":"library-card","children":[["$","h3",null,{"children":"3. Guided Quran reading"}],["$","p",null,{"children":"Read connected Quranic words and verses aloud while the tutor corrects pronunciation, hesitation, tracking and common joining mistakes."}]]}],["$","section","4. Practical Tajweed correction",{"className":"library-card","children":[["$","h3",null,{"children":"4. Practical Tajweed correction"}],["$","p",null,{"children":"Develop makharij and relevant recitation rules through short explanation, live application and repeated correction in the assigned passage."}]]}],["$","section","5. Hifz and revision where suitable",{"className":"library-card","children":[["$","h3",null,{"children":"5. Hifz and revision where suitable"}],["$","p",null,{"children":"Learners with an appropriate reading foundation can follow a memorization goal that balances a new portion with recent and older revision."}]]}],["$","section","6. Review and continuing pathway",{"className":"library-card","children":[["$","h3",null,{"children":"6. Review and continuing pathway"}],["$","p",null,{"children":"The tutor reviews applied skills and recommends whether to consolidate the current course or continue into a connected Quran-learning goal."}]]}]]}]
