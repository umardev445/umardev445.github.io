1b:["$","div",null,{"className":"library-grid","children":[["$","section","Confirm the current goal",{"className":"library-card","children":[["$","h3",null,{"children":"Confirm the current goal"}],["$","p",null,{"children":"The tutor begins with the learner's existing course target and reviews the assigned reading, recitation or memorization."}]]}],["$","section","Demonstrate the next skill",{"className":"library-card","children":[["$","h3",null,{"children":"Demonstrate the next skill"}],["$","p",null,{"children":"A suitable letter, word, rule or verse is explained and modelled according to the learner's age and present level."}]]}],["$","section","Listen and correct privately",{"className":"library-card","children":[["$","h3",null,{"children":"Listen and correct privately"}],["$","p",null,{"children":"The learner reads or recites aloud in the one-to-one lesson and repeats the exact section that needs improvement."}]]}],["$","section","Set the next practice target",{"className":"library-card","children":[["$","h3",null,{"children":"Set the next practice target"}],["$","p",null,{"children":"The class closes with a manageable assignment and a clear priority to revisit before the next session."}]]}]]}]
