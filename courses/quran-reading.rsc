13:["$","p",null,{"children":"The exact starting point and pace depend on the initial assessment. These stages show the skills a learner can work through without promising an identical timeline for every student."}]
14:["$","div",null,{"className":"library-grid","children":[["$","section","1. Starting-level reading assessment",{"className":"library-card","children":[["$","h3",null,{"children":"1. Starting-level reading assessment"}],["$","p",null,{"children":"The tutor checks letter recognition, joining, vowel patterns, pronunciation and the learner's ability to follow a line of Quranic text."}]]}],["$","section","2. Transition from Qaida to Mushaf",{"className":"library-card","children":[["$","h3",null,{"children":"2. Transition from Qaida to Mushaf"}],["$","p",null,{"children":"Previously learned reading patterns are applied to real Quranic words and short passages, with support where the script feels unfamiliar."}]]}],["$","section","3. Accurate word and verse reading",{"className":"library-card","children":[["$","h3",null,{"children":"3. Accurate word and verse reading"}],["$","p",null,{"children":"The learner practises connected words and complete verses while receiving immediate correction for skipped, added or confused sounds."}]]}],["$","section","4. Fluency without rushing",{"className":"library-card","children":[["$","h3",null,{"children":"4. Fluency without rushing"}],["$","p",null,{"children":"Guided repetition helps reduce unnecessary pauses while protecting accuracy. Speed is increased only when the learner can maintain control."}]]}],["$","section","5. Stopping signs and verse transitions",{"className":"library-card","children":[["$","h3",null,{"children":"5. Stopping signs and verse transitions"}],["$","p",null,{"children":"Common pause signs and natural stopping points are introduced progressively so the learner can stop and restart more carefully."}]]}],["$","section","6. Longer passages and independent practice",{"className":"library-card","children":[["$","h3",null,{"children":"6. Longer passages and independent practice"}],["$","p",null,{"children":"As reading becomes steadier, the learner works through longer selections, reviews recurring mistakes and follows a realistic home-practice target."}]]}]]}]
15:["$","h2",null,{"children":"Who should take this course?"}]
16:["$","ul",null,{"children":[["$","li","Learners who have completed Noorani Qaida or an equivalent foundation",{"children":"Learners who have completed Noorani Qaida or an equivalent foundation"}],["$","li","Children who recognize Arabic letters but read Quranic words slowly",{"children":"Children who recognize Arabic letters but read Quranic words slowly"}],["$","li","Adults returning to Quran reading after a long break",{"children":"Adults returning to Quran reading after a long break"}],["$","li","Learners who can read but frequently hesitate or lose their place",{"children":"Learners who can read but frequently hesitate or lose their place"}],["$","li","Students who need stronger reading fluency before focused Tajweed or Hifz",{"children":"Students who need stronger reading fluency before focused Tajweed or Hifz"}]]}]
