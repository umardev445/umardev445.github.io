","$La",null,{"className":"text-link","href":"/courses/quran-classes-for-adults/","children":"Online Quran Classes for Adults"}]}],["$","li","quran-memorization",{"children":["$","$La",null,{"className":"text-link","href":"/courses/quran-memorization/","children":"Online Quran Memorization (Hifz)"}]}]]}]]}],["$","p",null,{"style":{"marginTop":24},"children":["$","$La",null,{"className":"text-link","href":"/blog/how-online-quran-classes-work/","children":["How online Quran classes work"," ",["$","$Lb",null,{"ref":"$undefined","iconNode":"$8:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]}]]}]
