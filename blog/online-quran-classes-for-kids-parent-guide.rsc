e:["$","div",null,{"className":"article-note","children":[["$","strong",null,{"children":"Need advice for your own level?"}],["$","p",null,{"children":"This guide offers general learning information. A live assessment can identify a more suitable starting point for an individual learner."}],["$","$La",null,{"className":"text-link","href":"/free-assessment/","children":["Book free assessment ",["$","$Lb",null,{"ref":"$undefined","iconNode":"$8:props:children:0:props:children:1:props:iconNode","className":"lucide-arrow-right"}]]}]]}]
