1:["$","main",null,{"id":"main-content","children":[["$","$Ld",null,{"eyebrow":"Academy information","title":"Refund & Cancellation Policy","description":"General information for monthly class plans. Confirm the current terms before payment.","compact":true}],["$","$Le",null,{"items":[{"name":"Home","href":"/"},{"name":"Refund & Cancellation Policy"}]}],["$","article",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell policy","children":[[["$","h2",null,{"children":"Monthly plan confirmation"}],["$","p",null,{"children":"Before paying, confirm the number and length of lessons, billing date, tutor schedule, holidays, make-up lesson rules and cancellation notice period."}],["$","h2",null,{"children":"Cancellation requests"}],["$","p",null,{"children":"Send a cancellation request through the listed email or WhatsApp contact before the next billing date. The effective date depends on the current written plan terms."}],["$","h2",null,{"children":"Missed lessons"}],["$","p",null,{"children":"Refund or make-up treatment for a missed lesson may depend on who cancelled, how much notice was given and whether replacement time is available."}],["$","h2",null,{"children":"Contact before payment"}],["$","p",null,{"children":["For the latest refund and cancellation terms, email ",["$","a",null,{"className":"text-link","href":"mailto:umarfarooq360official@gmail.com","children":"umarfarooq360official@gmail.com"}],". This page should be updated with the academy's final confirmed commercial policy before launch."]}]],["$","div",null,{"className":"notice","style":{"marginTop":45},"children":[["$","strong",null,{"children":"Keep this page current"}],["$","p",null,{"children":"Review this policy whenever payment, lesson delivery, data collection or child-safety processes change."}]]}]]}]}]]}]
