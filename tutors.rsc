12:["$","section",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell","children":[["$","$L10",null,{"eyebrow":"How tutor matching works","title":"A practical match for the learner, not a random assignment","description":"Tutor preference matters, but a useful match also depends on the learner's present level, course, communication needs and local schedule."}],["$","div",null,{"className":"steps-grid tutor-steps","children":[["$","article",null,{"className":"step-card","children":[["$","h3",null,{"children":"Share the learner's needs"}],["$","p",null,{"children":"Tell us the learner's age, current level, goal, preferred language, time zone and male or female tutor preference."}]]}],["$","article",null,{"className":"step-card","children":[["$","h3",null,{"children":"Review the starting point"}],["$","p",null,{"children":"A free assessment helps distinguish between Noorani Qaida, Quran reading, Tajweed, memorization and Islamic Studies needs."}]]}],["$","article",null,{"className":"step-card","children":[["$","h3",null,{"children":"Confirm a workable match"}],["$","p",null,{"children":"The coordinator considers teaching fit and availability before discussing a regular one-to-one lesson schedule."}]]}]]}]]}]}]
13:["$","section",null,{"className":"section section-dark","children":["$","div",null,{"className":"shell safety-layout","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow light","children":"For parents and guardians"}],["$","h2",null,{"children":"Clear boundaries around children's online lessons"}],["$","p",null,{"children":"A responsible adult should manage enrollment, know the lesson schedule and remain reasonably available for younger children. Learners should not be asked to share payment information, private contact details or sensitive documents during class."}],["$","$L8",null,{"className":"button button-ivory","href":"/child-safety/","children":["Read child-safety standards ",["$","$Lc",null,{"ref":"$undefined","iconNode":"$9:props:iconNode","className":"lucide-arrow-right"}]]}]]}],["$","div",null,{"className":"safety-points","children":[["$","span",null,{"children":[["$","$Lc",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:props:children:3:props:children:0:props:iconNode","className":"lucide-shield-check"}]," Shared or observable learning area for younger children"]}],["$","span",null,{"children":[["$","$Lc",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:props:children:3:props:children:0:props:iconNode","className":"lucide-shield-check"}]," Parent-managed enrollment and scheduling"]}],["$","span",null,{"children":[["$","$Lc",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:props:children:3:props:children:0:props:iconNode","className":"lucide-shield-check"}]," Respectful, approved communication channels"]}],["$","span",null,{"children":[["$","$Lc",null,{"ref":"$undefined","iconNode":"$1:props:children:2:props:children:props:children:3:props:children:0:props:iconNode","className":"lucide-shield-check"}]," No promotional recording without clear permission"]}]]}]]}]}]
14:["$","section",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell faq-layout","children":[["$","$L10",null,{"eyebrow":"Tutor questions","title":"What learners and parents usually ask","description":"Straight answers about qualifications, tutor preference, privacy, matching and parent awareness."}],["$","$L1d",null,{"items":[{"question":"Who are the online Quran tutors at QuranCrest Academy?","answer":"QuranCrest's current teaching faculty includes Maulana Muhammad Bakhtiar, Maulana Qazi Amjad and Alimah Sumera. Their published profiles explain their education, experience and teaching areas without making unverified certification claims."},{"question":"Can I choose a male or female Quran teacher?","answer":"Yes. Families and adult learners can share a male or female tutor preference during the free assessment. Final matching depends on the course, learner's level, language, time zone and current tutor availability."},{"question":"How does QuranCrest match a tutor with a learner?","answer":"The coordinator first considers the learner's age, present reading level, chosen course, preferred language, tutor preference and suitable local times. The aim is to arrange a practical teaching match rather than assign the same pathway to every student."},{"question":"Can parents remain aware of a child's online lessons?","answer":"Yes. Parents or guardians should manage enrollment, know the class schedule and remain reasonably available for younger learners. QuranCrest recommends that children attend from a shared or observable area of the home."},{"question":"Why is the female teacher's face not shown?","answer":"Her profile image is intentionally privacy-protected. The visual is a representative illustration rather than a personal photograph, and this is stated clearly so families are not misled."},{"question":"Can I discuss the tutor before regular classes begin?","answer":"Yes. Use the free assessment to discuss the learner's goals, course, preferred tutor, language and schedule before deciding on a regular lesson plan."}]}]]}]}]
15:["$","$L1e",null,{"title":"Discuss the learner before choosing a tutor","text":"Book a free assessment and share the learner's level, course goal, language, time zone and male or female tutor preference."}]
