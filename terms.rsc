1:["$","main",null,{"id":"main-content","children":[["$","$Lc",null,{"eyebrow":"Academy information","title":"Terms of Service","description":"General expectations for website use, enrollment, scheduling and online lessons.","compact":true}],["$","$Ld",null,{"items":[{"name":"Home","href":"/"},{"name":"Terms of Service"}]}],["$","article",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell policy","children":[[["$","h2",null,{"children":"Assessment and enrollment"}],["$","p",null,{"children":"The free assessment helps identify a suitable starting point but does not guarantee a particular tutor, schedule or learning outcome. Confirm the current plan details before making payment."}],["$","h2",null,{"children":"Attendance and scheduling"}],["$","p",null,{"children":"Students should join on time with the required material and working device. Make-up lesson, rescheduling and holiday arrangements should be confirmed with admissions because availability may vary."}],["$","h2",null,{"children":"Respectful use"}],["$","p",null,{"children":"Students, families, tutors and staff are expected to communicate respectfully. Website content may not be copied or presented as another academy's material without permission."}],["$","h2",null,{"children":"Learning outcomes"}],["$","p",null,{"children":"Progress depends on attendance, practice, starting level and individual learning pace. QuranCrest does not promise a fixed completion date unless a specific written plan states one."}]],["$","div",null,{"className":"notice","style":{"marginTop":45},"children":[["$","strong",null,{"children":"Keep this page current"}],["$","p",null,{"children":"Review this policy whenever payment, lesson delivery, data collection or child-safety processes change."}]]}]]}]}]]}]
