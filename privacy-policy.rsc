1:["$","main",null,{"id":"main-content","children":[["$","$Ld",null,{"eyebrow":"Academy information","title":"Privacy Policy","description":"A plain-language summary of information collected through QuranCrest's website and enrollment process.","compact":true}],["$","$Le",null,{"items":[{"name":"Home","href":"/"},{"name":"Privacy Policy"}]}],["$","article",null,{"className":"section section-paper","children":["$","div",null,{"className":"shell policy","children":[[["$","p",null,{"children":[["$","strong",null,{"children":"Last reviewed:"}]," 28 August 2026"]}],["$","h2",null,{"children":"Information you provide"}],["$","p",null,{"children":"Contact and assessment forms may collect a name, email address, phone or WhatsApp number, country, time zone, learner age, course interest and a description of the learner's current level or goal."}],["$","h2",null,{"children":"Why information is used"}],["$","p",null,{"children":"Information is used to respond to enquiries, arrange an assessment, recommend a course, coordinate scheduling and provide learning support. Do not submit card details, identification documents or unnecessary sensitive information through website forms."}],["$","h2",null,{"children":"Service providers"}],["$","p",null,{"children":"Website forms may be processed through the configured form service, while messages may be handled through email or WhatsApp. Those services have their own privacy practices."}],["$","h2",null,{"children":"Contact"}],["$","p",null,{"children":["For a privacy question or correction request, email ",["$","a",null,{"className":"text-link","href":"mailto:umarfarooq360official@gmail.com","children":"umarfarooq360official@gmail.com"}],"."]}]],["$","div",null,{"className":"notice","style":{"marginTop":45},"children":[["$","strong",null,{"children":"Keep this page current"}],["$","p",null,{"children":"Review this policy whenever payment, lesson delivery, data collection or child-safety processes change."}]]}]]}]}]]}]
